<Window x:Class="BlueBridge.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="zhanhBlueB" Icon="BlueBridge.ico" Width="980" Height="720" MinWidth="780" MinHeight="650" Background="#F5F7FB" Foreground="#172554" FontFamily="Microsoft YaHei UI" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver" Closing="WindowClosing">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="zhanhBlueB" FontSize="32" FontWeight="Bold"/><TextBlock Text="离线互传" FontSize="16" Foreground="#64748B" Margin="14,16,0,0"/></StackPanel><TextBlock Text="只需蓝牙，文字与文件自在流转" FontSize="14" Foreground="#64748B" Margin="0,6,0,20"/></StackPanel>
   <Button Grid.Column="1" Content="隐藏到托盘" Background="#E2E8F0" Foreground="#334155" VerticalAlignment="Top" Click="HideClick"/>
  </Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="24" Margin="0,0,0,20">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="设备连接" FontWeight="Bold" FontSize="17"/><TextBlock x:Name="ConnectionText" Text="蓝牙尚未开启监听" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,20,8"/><TextBlock Text="首次使用：在 Windows 和手机的蓝牙设置中完成配对，然后在手机zhanhBlueB中连接电脑。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,20,0"/></StackPanel>
    <Button Grid.Column="1" x:Name="ListenButton" Content="开启连接" Click="ListenClick" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="24">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="传输" FontWeight="Bold" FontSize="19"/><TextBlock x:Name="ActivityText" Grid.Column="1" Text="准备就绪" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/></Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,18"><Button x:Name="SendFilesButton" Content="选择文件发送" Click="SendFilesClick"/><Button Content="发送剪贴板" Click="SendClipboardClick" Background="#EFF6FF" Foreground="#2563EB"/><Button x:Name="SaveImageButton" Content="图片另存为" Click="SaveImageClick" Background="#EFF6FF" Foreground="#2563EB" IsEnabled="False"/></StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding Transfers}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><EventSetter Event="MouseDoubleClick" Handler="TransferDoubleClick"/><Style.Triggers><DataTrigger Binding="{Binding CanOpen}" Value="True"><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="双击打开图片或文件"/></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#64748B" FontSize="12" Margin="0,5,0,7"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="4" Foreground="#2563EB" BorderThickness="0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center"><Button Content="取消" Tag="{Binding Id}" Click="CancelTransferClick" Padding="10,6" Background="#E2E8F0" Foreground="#334155" IsEnabled="{Binding CanCancel}"/><Button Content="重试" Tag="{Binding Id}" Click="RetryTransferClick" Padding="10,6" Background="#EFF6FF" Foreground="#2563EB" IsEnabled="{Binding CanRetry}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="3" Text="双击已完成的记录打开图片或文件 · 也可拖入多个文件" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="AutoClipboardBox" Content="连接时自动发送电脑复制的文字和图片" Checked="AutoClipboardChanged" Unchecked="AutoClipboardChanged"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="StartupBox" Content="开机启动" Checked="StartupChanged" Unchecked="StartupChanged" Margin="0,4,20,4"/><Button Content="清除信任" Click="ForgetTrustClick" Background="Transparent" Foreground="#64748B" Padding="4" FontSize="12"/></StackPanel><TextBlock x:Name="DestinationText" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="打开下载目录" Click="OpenFolderClick" Background="#E2E8F0" Foreground="#334155" VerticalAlignment="Center"/></Grid>
 </Grid>
</Window>
